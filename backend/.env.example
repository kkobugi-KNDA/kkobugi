KKOBUGI_APP_NAME="꼬부기 API"
KKOBUGI_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
KKOBUGI_ENVIRONMENT=development
# 상대 경로는 backend 기준. 기존 DB 파일을 유지하면 계정·세션도 유지됨.
KKOBUGI_DATABASE_PATH=.runtime/kkobugi.sqlite3
KKOBUGI_DATASET_STORAGE_PATH=.runtime/datasets
KKOBUGI_MODEL_STORAGE_PATH=.runtime/models
KKOBUGI_MAX_PENDING_RUNS=8
KKOBUGI_MAX_TRAINING_ROWS=250000
KKOBUGI_MAX_TRAINING_FEATURES=128
KKOBUGI_MAX_UPLOAD_BYTES=209715200
KKOBUGI_MAX_DATASET_ROWS=1000000
KKOBUGI_MAX_DATASET_COLUMNS=256
KKOBUGI_COOKIE_SECURE=false
KKOBUGI_SESSION_TTL_SECONDS=43200
KKOBUGI_LOGIN_MAX_ATTEMPTS=5
KKOBUGI_LOGIN_WINDOW_SECONDS=900
# 같은 출처 /api 프록시를 쓸 때 프런트엔드 주소를 추가.
KKOBUGI_TRUSTED_ORIGINS=[]
# 같은 서버에서 프런트 빌드까지 제공할 때만 설정. Docker에서는 자동 지정됨.
# KKOBUGI_FRONTEND_DIST_PATH=../frontend/dist
